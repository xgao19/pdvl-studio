# Configure only the providers you use. Keep real credentials in .env.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Optional compatible endpoint.
CUSTOM_API_BASE=
CUSTOM_API_KEY=
CUSTOM_MODEL=local-model

# Configure PDVL_HOME/codex/config.toml with an env_key provider (docs/PROVIDERS.md).
PDVL_CODEX_ENABLED=0

PDVL_HOME=.local
PDVL_PORT=8765
