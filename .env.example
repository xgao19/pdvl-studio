# Configure only the providers you use. Keep real credentials in .env.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Optional compatible endpoint.
CUSTOM_API_BASE=
CUSTOM_API_KEY=
CUSTOM_MODEL=local-model

# Enable only after installing and authenticating the Codex runtime.
PDVL_CODEX_ENABLED=0
PDVL_CODEX_MODEL=

PDVL_HOME=.local
PDVL_PORT=8765
